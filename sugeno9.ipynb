   "outputs": [],
   "source": [
    "membership_values = [0.0, 0.25, 0.5, 0.75, 1.0]\n",
    "\n",
    "lambda_value = 0.5\n",
    "\n",
    "sugeno = []\n",
    "\n",
    "for mu in membership_values:\n",
    "    result = (1 - mu) / (1 + lambda_value * mu)\n",
    "    sugeno.append(result)\n",
    "\n",
    "print(\"Original Membership Values:\", membership_values)\n",
    "print(\"Sugeno Complement:\", sugeno)"
   ]
  }
 ],

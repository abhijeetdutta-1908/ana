   "source": [
    "import random\n",
    "\n",
    "s = \"11001100\"\n",
    "\n",
    "print(\"Original:\", s)\n",
    "\n",
    "l = list(s)\n",
    "\n",
    "for i in range(len(l)):\n",
    "    if random.random() < 0.2:\n",
    "        l[i] = str(1 - int(l[i]))\n",
    "\n",
    "print(\"Mutated:\", \"\".join(l))"
   ]
